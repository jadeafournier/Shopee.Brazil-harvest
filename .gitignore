# ---------------------------------------------------------------------
#  Shopee.Brazil/ : 수집 데이터 폴더 제외 (루트 스크립트/설정만)
# ---------------------------------------------------------------------
/Shopee.Brazil/Upload/
/Shopee.Brazil/Sessions/
/Shopee.Brazil/Download/
/Shopee.Brazil/New folder/
/Shopee.Brazil/New folder (2)/

# ---------------------------------------------------------------------
#  전역: 캐시·바이너리·대용량·로그 제외
# ---------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.apk
*.jar
*.dex
*.class
*.log
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.zip
*.7z
*.rar
*.db
