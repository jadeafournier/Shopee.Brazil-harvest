/runtime/zb9_sfu_40k_probe/
/runtime/zb9_sfu_cookie_safe/
/runtime/tw_proxy_health/
/runtime/full_getpc_req_explore_20260906/
/runtime/anon_explore_20260905/
/runtime/dual_lane/
/runtime/tw_1m_hybrid_solution_20260906/
/runtime/tw_single_cookie_sustain_20260906/

# vmos_cloud 대용량 바이너리/덤프/세션 (코드 아님)
/runtime/vmos_cloud/shopee_br_apk/
/runtime/vmos_cloud/phone_egress/
/runtime/vmos_cloud/sessions/

# ---------------------------------------------------------------------
